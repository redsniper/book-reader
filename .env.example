# 墨阅本机开发环境模板。
# 使用方式：
#   1. cp .env.example .env.local
#   2. 填写本机绝对路径（路径含空格时保留双引号）
#   3. 在仓库根目录执行：. scripts/dev-env.sh
# .env.local 已加入 .gitignore，禁止提交。
#
# JDK 21 根目录。macOS 的 JDK 通常需指向 .../Contents/Home。
JAVA_HOME="/absolute/path/to/jdk-21"
# Android SDK 根目录（应包含 platforms/android-35、build-tools/35.0.0、platform-tools）。
ANDROID_HOME="/absolute/path/to/android-sdk"
# 可选：黑盒测试数据生成所需的中文字体文件（.ttf/.ttc）。
# 仅构建/运行 app 时可不填；运行 black-box fixtures generator 时必填。
MOYUE_CJK_FONT="/absolute/path/to/chinese-font.ttc"
# 可选：黑盒测试使用的 AVD 名称，默认 moyue_api35。
MOYUE_AVD_NAME="moyue_api35"
